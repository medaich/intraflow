# ==============================================================================
# Intraflow Web Client — Environment Configuration
# ==============================================================================
# This file defines the frontend environment variables for Intraflow.
# Copy this file to `.env` (or `.env.local` for local overrides).
#
# Vite requires public frontend environment variables to be prefixed with `VITE_`.
# Variables without this prefix are NOT exposed to the client-side JavaScript bundle.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend REST API URL
# ------------------------------------------------------------------------------
# The base URL of the running Intraflow NestJS backend API.
#
# Development (Default):
#   VITE_API_URL=http://localhost:3000
#
# Production / Staging:
#   VITE_API_URL=https://api.intraflow.yourdomain.com
#
# Important Note on Cross-Origin Session Cookies:
#   Intraflow uses HTTP-only signed session cookies (`withCredentials: true`).
#   - In DEVELOPMENT:
#       Frontend runs on `http://localhost:5173` and API runs on `http://localhost:3000`.
#       The backend CORS configuration MUST explicitly set `CORS_ORIGIN=http://localhost:5173`
#       and credentials must be allowed.
#   - In PRODUCTION:
#       The frontend and backend API SHOULD preferably share the same top-level domain
#       (e.g., `app.intraflow.dev` and `api.intraflow.dev`), or HTTPS must be enabled
#       with `SameSite=None; Secure` cookie attributes on the backend.
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Application Client URL (Reference for Backend Correspondence)
# ------------------------------------------------------------------------------
# In local development, the Vite dev server runs on port 5173.
# The backend API `.env` should set `APP_URL=http://localhost:5173` so that all
# transactional emails (user invitations, password resets, email change confirmations)
# generate links targeting this frontend instance:
#   - Invitation Onboarding:  http://localhost:5173/signup?token=...
#   - Password Reset:         http://localhost:5173/reset-password?token=...
#   - Email Confirmation:     http://localhost:5173/confirm-email?token=...
VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Local Mail Testing Inbox (Mailpit / Inbucket)
# ------------------------------------------------------------------------------
# For development environments, transactional emails are trapped by Mailpit.
# Web UI is typically accessible at:
#   http://localhost:8025
# ------------------------------------------------------------------------------
